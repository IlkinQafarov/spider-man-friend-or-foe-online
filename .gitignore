# Own-source repository. Deny assets, saves, logs, account data and binaries.
*
!.gitignore
!.gitattributes
!PROTOTYPE.md
!README.md
!LICENSE
!docs/
docs/*
!docs/STATUS.md
!docs/ROADMAP.md
!docs/BUILDING.md
!docs/TESTING.md
!docs/ARCHITECTURE.md
!docs/banner.svg
!probe/
probe/*
!probe/*.cpp
!probe/*.hpp
!probe/*.inc
!probe/*.cmd
!probe/README.md
!steam/
steam/*
!steam/*.py
!steam/*.cpp
!steam/*.cmd
!steam/README.md
!steam/native/
steam/native/*
!steam/native/*.cpp
!steam/native/*.hpp
!steam/native/*.cmd
!steam/native/README.md
!steam/native/steam_appid.txt
!launcher/
launcher/*
!launcher/*.cs
!launcher/*.cmd
!launcher/*.py
!launcher/README.md
!compatibility/
compatibility/*
!compatibility/*.py
!compatibility/baseline.json
!compatibility/README.md
!qa/
qa/*
!qa/*.py
!qa/README.md
!analysis/
analysis/*
!analysis/native/
analysis/native/*
!analysis/native/score_pair.py
