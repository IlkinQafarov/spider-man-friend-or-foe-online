                <Button x:Name="CloseButton" AutomationProperties.Name="Close" Grid.Column="1" Style="{StaticResource ReferenceChromeButton}"><Canvas Width="121" Height="104"><Path Data="F0 M36,36 L37,36 L37,35 L41,35 L41,36 L42,36 L42,37 L43,37 L43,38 L44,38 L44,39 L45,39 L45,40 L46,40 L46,41 L47,41 L47,42 L48,42 L48,43 L49,43 L49,44 L50,44 L50,45 L51,45 L51,46 L52,46 L52,47 L53,47 L53,48 L54,48 L54,49 L57,49 L57,48 L58,48 L58,47 L59,47 L59,46 L60,46 L60,45 L61,45 L61,44 L62,44 L62,43 L63,43 L63,42 L64,42 L64,41 L65,41 L65,40 L66,40 L66,39 L67,39 L67,38 L68,38 L68,37 L69,37 L69,36 L70,36 L70,35 L74,35 L74,36 L75,36 L75,38 L74,38 L74,39 L73,39 L73,40 L72,40 L72,41 L71,41 L71,42 L70,42 L70,43 L69,43 L69,45 L67,45 L67,47 L65,47 L65,49 L63,49 L63,51 L61,51 L61,56 L63,56 L63,58 L65,58 L65,60 L67,60 L67,61 L68,61 L68,62 L69,62 L69,63 L70,63 L70,64 L71,64 L71,65 L72,65 L72,67 L74,67 L74,69 L75,69 L75,71 L74,71 L74,72 L73,72 L73,73 L71,73 L71,72 L70,72 L70,71 L69,71 L69,70 L68,70 L68,69 L67,69 L67,68 L66,68 L66,67 L65,67 L65,66 L64,66 L64,65 L63,65 L63,64 L62,64 L62,63 L61,63 L61,62 L59,62 L59,60 L58,60 L58,59 L57,59 L57,58 L55,58 L55,59 L53,59 L53,60 L52,60 L52,61 L51,61 L51,62 L50,62 L50,63 L49,63 L49,64 L48,64 L48,65 L47,65 L47,66 L46,66 L46,67 L45,67 L45,68 L44,68 L44,69 L43,69 L43,70 L42,70 L42,71 L41,71 L41,72 L40,72 L40,73 L39,73 L39,72 L37,72 L37,70 L36,70 L36,69 L37,69 L37,68 L38,68 L38,67 L39,67 L39,66 L40,66 L40,65 L41,65 L41,64 L42,64 L42,63 L43,63 L43,62 L44,62 L44,61 L45,61 L45,60 L46,60 L46,59 L47,59 L47,58 L48,58 L48,57 L49,57 L49,56 L50,56 L50,55 L51,55 L51,52 L49,52 L49,50 L47,50 L47,48 L46,48 L46,47 L45,47 L45,46 L44,46 L44,45 L42,45 L42,43 L40,43 L40,41 L39,41 L39,40 L38,40 L38,39 L37,39 L37,38 L36,38 Z" Fill="#101210"/></Canvas></Button>
              </Grid>
            </Border>
          </Canvas>
        </Viewbox>

        <!-- Host and join photos are clipped to the approved comic panel silhouettes. -->
        <Button x:Name="HostButton" Canvas.Left="24" Canvas.Top="410" Width="736" Height="510" Style="{StaticResource FlatButton}">
          <Grid ClipToBounds="True" Background="#E2E5E9">
            <Image x:Name="HostArt" Stretch="UniformToFill"/>
            <Viewbox x:Name="HostContentFit" Stretch="Uniform"><Canvas x:Name="HostForeground" Width="805" Height="499" IsHitTestVisible="False">
              <Image x:Name="HostIcon" Canvas.Left="365" Canvas.Top="104" Width="200" Height="165" Stretch="Uniform"/>
              <Polygon x:Name="HostTicket" Points="135,310 780,285 765,316 790,334 770,355 788,380 765,405 781,455 120,479 139,452 100,431 130,402 105,380 135,355 110,336" Fill="#FFFFFF" Stroke="#17191D" StrokeThickness="4"/>
              <Canvas x:Name="HostTicketText" Canvas.Left="155" Canvas.Top="310" Width="560" Height="145" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform Angle="-2.2"/></Canvas.RenderTransform>
                <Viewbox x:Name="HostTitleFit" Width="560" Height="112" Stretch="Uniform"><TextBlock x:Name="HostLabel" Text="HOST A GAME" FontFamily="Impact" FontSize="110" FontStyle="Italic" FontWeight="Bold" Foreground="#111318"/></Viewbox>
                <Viewbox x:Name="HostSubFit" Canvas.Left="35" Canvas.Top="106" Width="460" Height="32" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="HostSub" Text="Start a session" FontFamily="Segoe UI Semibold" FontSize="27" Foreground="#111318"/></Viewbox>
              </Canvas>
              <TextBlock Canvas.Left="703" Canvas.Top="408" Text="➜" FontFamily="Segoe UI Symbol" FontSize="44" FontWeight="Bold" Foreground="#D52C36"/>
            </Canvas></Viewbox>
            <Rectangle x:Name="HostPanelFrame" Stroke="#15171D" StrokeThickness="5" IsHitTestVisible="False"/>
          </Grid>
        </Button>
        <Button x:Name="JoinButton" Canvas.Left="776" Canvas.Top="410" Width="736" Height="510" Style="{StaticResource FlatButton}">
          <Grid ClipToBounds="True" Background="#E2E5E9">
            <Image x:Name="JoinArt" Stretch="UniformToFill"/>
            <Viewbox x:Name="JoinContentFit" Stretch="Uniform"><Canvas x:Name="JoinForeground" Width="750" Height="474" IsHitTestVisible="False">
              <Image x:Name="JoinIcon" Canvas.Left="229" Canvas.Top="106" Width="255" Height="132" Stretch="Uniform"/>
              <Polygon x:Name="JoinTicket" Points="100,277 690,257 674,290 702,308 679,331 699,352 680,374 690,428 87,447 104,420 70,401 94,372 72,352 102,326 77,307" Fill="#FFFFFF" Stroke="#17191D" StrokeThickness="4"/>
              <Canvas x:Name="JoinTicketText" Canvas.Left="110" Canvas.Top="282" Width="540" Height="145" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform Angle="-1.9"/></Canvas.RenderTransform>
                <Viewbox x:Name="JoinTitleFit" Width="540" Height="112" Stretch="Uniform"><TextBlock x:Name="JoinLabel" Text="JOIN A FRIEND" FontFamily="Impact" FontSize="110" FontStyle="Italic" FontWeight="Bold" Foreground="#111318"/></Viewbox>
                <Viewbox x:Name="JoinSubFit" Canvas.Left="30" Canvas.Top="106" Width="450" Height="32" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="JoinSub" Text="Play together" FontFamily="Segoe UI Semibold" FontSize="27" Foreground="#111318"/></Viewbox>
              </Canvas>
              <TextBlock Canvas.Left="620" Canvas.Top="376" Text="➜" FontFamily="Segoe UI Symbol" FontSize="44" FontWeight="Bold" Foreground="#2565D6"/>
            </Canvas></Viewbox>
            <Rectangle x:Name="JoinPanelFrame" Stroke="#15171D" StrokeThickness="5" IsHitTestVisible="False"/>
          </Grid>
        </Button>

        <Path x:Name="HeaderDivider" Data="M24,390 L1512,390" Stroke="#15171D" StrokeThickness="4" IsHitTestVisible="False"/>
        <TextBlock x:Name="AccessibleTitle" Canvas.Left="70" Canvas.Top="125" Width="1150" Text="Spider-Man: Friend or Foe" FontFamily="Segoe UI" FontSize="58" FontWeight="SemiBold" Foreground="#15171D" Visibility="Collapsed"/>
        <TextBlock x:Name="AccessibleSubtitle" Canvas.Left="74" Canvas.Top="218" Text="Online co-op" FontFamily="Segoe UI" FontSize="32" Foreground="#15171D" Visibility="Collapsed"/>

        <!-- Compact session strip only appears while the backend reports an active session. -->
        <Border x:Name="SessionBar" Canvas.Left="24" Canvas.Top="758" Width="1488" Height="168" Background="White" BorderBrush="#15171D" BorderThickness="2" Visibility="Collapsed">
          <Grid Margin="18,12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ActivityScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8"><TextBlock x:Name="ActivityText" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></ScrollViewer>
            <Grid x:Name="LobbyRow" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="LobbyLabel" Grid.Column="0" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
              <TextBox x:Name="LobbyText" Grid.Column="1" IsReadOnly="True" FontFamily="Segoe UI" FontSize="34" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining" BorderThickness="0" Background="White" Foreground="Black" VerticalContentAlignment="Center" Height="56" MinWidth="440"/>
              <Button x:Name="CopyLobby" Grid.Column="2" Style="{StaticResource CardButton}" Height="56" MinWidth="185" Margin="12,0,0,0"/>
              <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource CardButton}" Height="56" MinWidth="210" Margin="12,0,0,0"/>
            </Grid>
          </Grid>
        </Border>

        <!-- White footer: two consistently centered readiness badges. -->
        <Border Canvas.Left="0" Canvas.Top="936" Width="1536" Height="88" Background="White" BorderBrush="#17191D" BorderThickness="0,3,0,0"/>
        <Grid x:Name="GameBadge" Canvas.Left="32" Canvas.Top="948" Width="420" Height="65">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid Width="44" Height="44"><Ellipse x:Name="GameDot" Fill="#258A59"/><Viewbox Width="25" Height="25"><Canvas Width="28" Height="28"><Path x:Name="GameCheck" Data="M4,14.5 L11,21.5 L24,6.5" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid>
            <TextBlock x:Name="GameStatus" Margin="16,0,0,0" MaxWidth="510" VerticalAlignment="Center" Text="Game ready" FontFamily="Segoe UI Semibold" FontSize="24" Foreground="#17191D" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="SteamBadge" Canvas.Left="480" Canvas.Top="948" Width="650" Height="65">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid Width="44" Height="44"><Ellipse x:Name="SteamDot" Fill="#C78A26"/><Viewbox Width="25" Height="25"><Canvas Width="28" Height="28"><Path x:Name="SteamMark" Data="M14,4 L14,16 M14,23 L14,24" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid>
            <TextBlock x:Name="SteamStatus" Margin="16,0,0,0" MaxWidth="580" VerticalAlignment="Center" Text="Steam: Setup needed" FontFamily="Segoe UI Semibold" FontSize="24" Foreground="#17191D" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <ToggleButton x:Name="AccessibilityButton" Canvas.Left="1438" Canvas.Top="948" Width="58" Height="58" AutomationProperties.Name="Accessibility mode" ToolTip="Accessibility mode" Background="White" BorderBrush="#15171D" BorderThickness="1" Cursor="Hand">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#CDDDF6"/><Setter TargetName="ToggleSurface" Property="BorderThickness" Value="3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#E6EDF9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          <Viewbox Width="35" Height="35"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="11" Canvas.Top="4" Width="2" Height="2" Stroke="#15171D" StrokeThickness="2"/><Path Data="m9 20 3-6 3 6" Stroke="#15171D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="m6 8 6 2 6-2" Stroke="#15171D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M12 10v4" Stroke="#15171D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
        </ToggleButton>

        <!-- Modal card layer. Only one card is made visible at a time. -->
        <Grid KeyboardNavigation.TabNavigation="Cycle" x:Name="Overlay" Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1024" Background="#A8001018" Visibility="Collapsed">
          <Border x:Name="JoinCard" Width="690" Height="385" Background="#FFFFFF" BorderBrush="#14171C" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Grid.Row="0" LastChildFill="False"><TextBlock x:Name="JoinCardTitle" FontFamily="Impact" FontSize="42" FontStyle="Italic" Foreground="#15171D"/><Button x:Name="JoinCardClose" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="48" Height="42" Content="×"/></DockPanel>
              <TextBlock x:Name="JoinCardHint" Grid.Row="1" Margin="2,16,0,8" FontFamily="Segoe UI" FontSize="19" TextWrapping="Wrap" Foreground="#343944"/>
              <TextBox x:Name="JoinCodeBox" Grid.Row="2" Style="{StaticResource FieldText}" FontFamily="Consolas" FontSize="23" MaxLength="20"/>
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="JoinPaste" Style="{StaticResource CardButton}" Content="Paste code"/>
                <Button x:Name="JoinCancel" Style="{StaticResource CardButton}" Content="Cancel"/>
                <Button x:Name="JoinSubmit" Style="{StaticResource CardButton}" Background="#E8F0FF" Content="JOIN" MinWidth="130"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="HelpCard" Width="790" Height="500" Background="#FFFFFF" BorderBrush="#14171C" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel LastChildFill="False"><TextBlock x:Name="HelpCardTitle" FontFamily="Impact" FontSize="42" FontStyle="Italic" Foreground="#15171D"/><Button x:Name="HelpCardClose" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="48" Height="42" Content="×"/></DockPanel>
              <TextBlock x:Name="HelpCardBody" Grid.Row="1" Margin="5,28,5,12" FontFamily="Segoe UI" FontSize="22" LineHeight="32" TextWrapping="Wrap" Foreground="#252A32" VerticalAlignment="Top"/>
              <Button x:Name="HelpDone" Grid.Row="2" Style="{StaticResource CardButton}" Content="OK" HorizontalAlignment="Right" MinWidth="120"/>
            </Grid>
          </Border>
          <Border x:Name="SettingsCard" Width="910" Height="830" Background="#FFFFFF" BorderBrush="#14171C" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Grid.Row="0" LastChildFill="False"><TextBlock x:Name="SettingsTitle" FontFamily="Impact" FontSize="42" FontStyle="Italic" Foreground="#15171D"/><Button x:Name="SettingsCardClose" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="48" Height="42" Content="×"/></DockPanel>
              <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="UiLanguageLabel" Margin="2,7,0,4" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                  <ComboBox x:Name="SettingsLanguageBox" Style="{StaticResource FieldBox}"/>
                  <TextBlock x:Name="GameLanguageLabel" Margin="2,13,0,4" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                  <ComboBox x:Name="GameLanguageBox" Style="{StaticResource FieldBox}"/>
                  <TextBlock x:Name="DisplayLabel" Margin="2,13,0,4" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                  <ComboBox x:Name="DisplayBox" Style="{StaticResource FieldBox}"/>
                  <ComboBox x:Name="ResolutionBox" Style="{StaticResource FieldBox}" Margin="0,7,0,0"/>
                  <TextBlock x:Name="SteamLabel" Margin="2,13,0,4" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                  <DockPanel><Button x:Name="SteamBrowse" DockPanel.Dock="Right" Style="{StaticResource CardButton}" Content="Choose manually..."/><TextBox x:Name="SteamPathBox" Style="{StaticResource FieldText}" IsReadOnly="True"/></DockPanel>
                  <WrapPanel Orientation="Horizontal" Margin="0,8,0,4"><Button x:Name="VerifyButton" Style="{StaticResource CardButton}" Content="Verify copy"/><Button x:Name="ImportButton" Style="{StaticResource CardButton}" Content="Locate game install"/>
        <Button x:Name="HelpButton" Style="{StaticResource CardButton}">
          <TextBlock x:Name="HelpText" Text="ⓘ  Help" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="#17191D"/>
        </Button></WrapPanel>
                  <TextBlock x:Name="LogLabel" Margin="2,13,0,4" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                  <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#101827" Foreground="#DAE2F2"/>
                </StackPanel>
              </ScrollViewer>
              <Button x:Name="SettingsDone" Grid.Row="2" Style="{StaticResource CardButton}" Content="Done" HorizontalAlignment="Right" MinWidth="120"/>
            </Grid>
          </Border>
        </Grid>
      </Canvas>
    </Viewbox>
  </Border>
</Window>
