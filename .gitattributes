# Keep the pinned manifest bytes identical on every checkout.
* text=auto
compatibility/baseline.json -text
steam/native/steam_appid.txt -text

launcher/assets/backgrounds/*.png -text

launcher/assets/foreground/*.png -text

launcher/*.xaml text eol=lf

# Preserve pinned third-party SVG, license and provenance bytes across platforms.
launcher/assets/icons/* -text whitespace=cr-at-eol

launcher/assets/rooftop/*.png -text
launcher/assets/comic-paper/*.png -text
launcher/assets/sounds/*.wav -text
